<resources>
    <style name="AppTheme" parent="android:style/Theme.Material">
        <item name="android:windowBackground">#101214</item>
        <item name="android:colorBackground">#101214</item>
        <item name="android:textColorPrimary">#F0F0F0</item>
        <item name="android:textColorSecondary">#BFC5CA</item>
        <item name="android:textSize">12sp</item>
        <item name="android:colorAccent">#7CD5B6</item>
        <item name="android:statusBarColor">#101214</item>
        <item name="android:navigationBarColor">#101214</item>
        <item name="android:actionBarStyle">@style/CompactActionBar</item>
        <item name="android:buttonStyle">@style/CompactButton</item>
    </style>
    <style name="CompactActionBar" parent="android:style/Widget.Material.ActionBar.Solid">
        <item name="android:background">#191D21</item>
        <item name="android:titleTextStyle">@style/CompactTitle</item>
    </style>
    <style name="CompactTitle" parent="android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="CompactButton" parent="android:style/Widget.Material.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>

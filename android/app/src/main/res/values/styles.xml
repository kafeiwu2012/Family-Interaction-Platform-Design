<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light">
        <item name="android:windowBackground">@drawable/page_background</item>
        <item name="android:colorBackground">#FAFAFA</item>
        <item name="android:textColorPrimary">#212121</item>
        <item name="android:textColorSecondary">#616161</item>
        <item name="android:textSize">12sp</item>
        <item name="android:colorAccent">#009688</item>
        <item name="android:statusBarColor">#424242</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:actionBarStyle">@style/CompactActionBar</item>
        <item name="android:buttonStyle">@style/CompactButton</item>
    </style>
    <style name="CompactActionBar" parent="android:style/Widget.Material.Light.ActionBar.Solid">
        <item name="android:background">#F5F5F5</item>
        <item name="android:titleTextStyle">@style/CompactTitle</item>
    </style>
    <style name="CompactTitle" parent="android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#212121</item>
    </style>
    <style name="CompactButton" parent="android:style/Widget.Material.Light.Button">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
